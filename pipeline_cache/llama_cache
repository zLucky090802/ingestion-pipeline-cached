2227135, 0.003659468609839678, -0.005156656261533499, -0.01717834360897541, 0.09544220566749573, -0.03808806464076042, -0.014949740841984749], "metadata": {"file_path": "C:\\Users\\Daniel\\Documents\\llamaindex-course\\llamaindex-docs\\python_examples_agent_agent_workflow_basic.md", "file_name": "python_examples_agent_agent_workflow_basic.md", "file_type": "text/markdown", "file_size": 12702, "creation_date": "2026-04-23", "last_modified_date": "2026-04-23"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "0a43c562-3b37-4078-a305-cea88203aab2", "node_type": "4", "metadata": {"file_path": "C:\\Users\\Daniel\\Documents\\llamaindex-course\\llamaindex-docs\\python_examples_agent_agent_workflow_basic.md", "file_name": "python_examples_agent_agent_workflow_basic.md", "file_type": "text/markdown", "file_size": 12702, "creation_date": "2026-04-23", "last_modified_date": "2026-04-23"}, "hash": "20142dc5dd1b4db8f68af62c03262457fda791f43d43464a9cdcddde5b35ab32", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "f4397b87-12a0-4f70-b819-bc231af6db22", "node_type": "1", "metadata": {"file_path": "C:\\Users\\Daniel\\Documents\\llamaindex-course\\llamaindex-docs\\python_examples_agent_agent_workflow_basic.md", "file_name": "python_examples_agent_agent_workflow_basic.md", "file_type": "text/markdown", "file_size": 12702, "creation_date": "2026-04-23", "last_modified_date": "2026-04-23"}, "hash": "11b835b546f5a598baa530b91ed7672d85d56d3579e6cb898a66260590fe3ef6", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "d305cf39-9a50-4687-b387-51aca4f25c88", "node_type": "1", "metadata": {}, "hash": "332c4a4d4cdff227868f82726b1ef723bd68068f5fc3692273578bf325bf6a93", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "```\r\n\r\n## Tools and State\r\n[Section titled \u201cTools and State\u201d](https://developers.llamaindex.ai/python/examples/agent/agent_workflow_basic/#tools-and-state)\r\nTools can also be defined that have access to the workflow context. This means you can set and retrieve variables from the context and use them in the tool or between tools.\r\n**Note:** The `Context` parameter should be the first parameter of the tool.\r\n\r\n```\r\n\r\n\r\nfrom llama_index.core.workflow import Context\r\n\r\n\r\n\r\n\r\n\r\n\r\nasyncdefset_name(ctx: Context, name: str) -> str:\r\n\r\n\r\n\r\n\r\nasyncwith ctx.store.edit_state() as ctx_state:\r\n\r\n\r\n\r\n\r\nctx_state[\"state\"][\"name\"] = name\r\n\r\n\r\n\r\n\r\nreturnf\"Name set to {name}\"\r\n\r\n\r\n\r\n\r\n\r\n\r\nagent = FunctionAgent(\r\n\r\n\r\n\r\n\r\ntools=[set_name],\r\n\r\n\r\n\r\n\r\nllm=llm,\r\n\r\n\r\n\r\n\r\nsystem_prompt=\"You are a helpful assistant that can set a name.\",\r\n\r\n\r\n\r\n\r\ninitial_state={\"name\": \"unset\"},\r\n\r\n\r\n\r\n\r\n\r\n\r\nctx = Context(agent)\r\n\r\n\r\n\r\n\r\n\r\nresponse =await agent.run(user_msg=\"My name is Logan\", ctx=ctx)\r\n\r\n\r\n\r\n\r\nprint(str(response))\r\n\r\n\r\n\r\n\r\n\r\nstate =await ctx.store.get(\"state\")\r\n\r\n\r\n\r\n\r\nprint(state[\"name\"])\r\n\r\n\r\n```\r\n\r\n\r\n```\r\n\r\nYour name has been set to Logan.\r\n\r\n\r\nLogan\r\n\r\n```\r\n\r\n## Human in the Loop\r\n[Section titled \u201cHuman in the Loop\u201d](https://developers.llamaindex.ai/python/examples/agent/agent_workflow_basic/#human-in-the-loop)\r\nTools can also be defined that involve a human in the loop. This is useful for tasks that require human input, such as confirming a tool call or providing feedback.\r\nUsing workflow events, we can emit events that require a response from the user. Here, we use the built-in `InputRequiredEvent` and `HumanResponseEvent` to handle the human in the loop, but you can also define your own events.\r\n`wait_for_event` will emit the `waiter_event` and wait until it sees the `HumanResponseEvent` with the specified `requirements`. The `waiter_id` is used to ensure that we only send one `waiter_event` for each `waiter_id`.", "mimetype": "text/plain", "start_char_idx": 7604, "end_char_idx": 9530, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, {"__data__": {"id_": "d305cf39-9a50-4687-b387-51aca4f25c88", "embedding": [-0.05895834416151047, -0.004861322697252035, -0.010828333906829357, -0.03364386782050133, -0.014306354336440563, -0.0545833483338356, 0.10620300471782684, 0.030717836692929268, 0.008743119426071644, -0.02164914272725582, -0.0007567053544335067, 0.0034025567583739758, 0.046122852712869644, 0.0016076544998213649, -0.053602151572704315, -0.023210715502500534, -0.03138217329978943, 0.027162380516529083, -0.04839956387877464, -0.04518093168735504, 0.025508303195238113, 0.022015755996108055, 0.006989810615777969, -0.02818184718489647, 0.011699498631060123, 0.01452560257166624, -0.01929962821304798, -0.011810727417469025, -0.007324164733290672, -0.15519121289253235, 0.0496571846306324, -0.04362332075834274, -0.04804808273911476, 0.010865537449717522, -0.01724424958229065, -0.0033088510390371084, 0.020977085456252098, 0.006558500230312347, 0.034481704235076904, 0.06230902299284935, 0.048003531992435455, -0.014998123981058598, -0.012599372304975986, -0.016876565292477608, -0.007881495170295238, -0.05283140018582344, 0.005077164154499769, 0.0027885588351637125, -0.0184707660228014, 0.011232755146920681, -0.030170399695634842, -0.04716898128390312, 0.03818808123469353, 0.0689052864909172, 0.017886482179164886, -0.047633782029151917, 0.019517969340085983, 0.0209774412214756, -0.0023730522952973843, 0.03378627821803093, 0.06928835809230804, -0.021946221590042114, -0.10267407447099686, 0.07163622230291367, -0.04437684640288353, 0.032688070088624954, -0.017163557931780815, -0.03496810793876648, -0.007449530065059662, 0.01604259759