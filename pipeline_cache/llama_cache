9f859-520a-4312-8c2b-c23247616cef", "node_type": "4", "metadata": {"file_path": "C:\\Users\\Daniel\\Documents\\llamaindex-course\\llamaindex-docs\\python_examples_agent_agent_builder.md", "file_name": "python_examples_agent_agent_builder.md", "file_type": "text/markdown", "file_size": 9599, "creation_date": "2026-04-23", "last_modified_date": "2026-04-23"}, "hash": "5a2dd4d5a82d7ef70cf93bd1bdf43f94ce58e86d55c88eff20e82875998cc2a4", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "75197641-cc29-4f2e-be3b-e646b981ae29", "node_type": "1", "metadata": {}, "hash": "dde362e9964f873edf395e8185f0ad977eeff640b23e5a21bd2879683031a6cf", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "[Skip to content](https://developers.llamaindex.ai/python/examples/agent/agent_builder/#_top)\r\n# GPT Builder Demo \r\nInspired by GPTs interface, presented at OpenAI Dev Day 2023. Construct an agent with natural language.\r\nHere you can build your own agent\u2026with another agent!\r\n\r\n```\r\n\r\n\r\n%pip install llama-index-embeddings-openai\r\n\r\n\r\n\r\n\r\n%pip install llama-index-llms-openai\r\n\r\n\r\n\r\n\r\n%pip install llama-index-readers-file\r\n\r\n\r\n```\r\n\r\n\r\n```\r\n\r\n\r\nimport os\r\n\r\n\r\n\r\n\r\n\r\nos.environ[\"OPENAI_API_KEY\"] =\"sk-...\"\r\n\r\n\r\n```\r\n\r\n\r\n```\r\n\r\n\r\nfrom llama_index.embeddings.openai import OpenAIEmbedding\r\n\r\n\r\n\r\n\r\nfrom llama_index.llms.openai import OpenAI\r\n\r\n\r\n\r\n\r\nfrom llama_index.core import Settings\r\n\r\n\r\n\r\n\r\n\r\nllm = OpenAI(model=\"gpt-4o\")\r\n\r\n\r\n\r\n\r\nSettings.llm = llm\r\n\r\n\r\n\r\n\r\nSettings.embed_model = OpenAIEmbedding(model=\"text-embedding-3-small\")\r\n\r\n\r\n```\r\n\r\n## Define Candidate Tools\r\n[Section titled \u201cDefine Candidate Tools\u201d](https://developers.llamaindex.ai/python/examples/agent/agent_builder/#define-candidate-tools)\r\nWe also define a tool retriever to retrieve candidate tools.\r\nIn this setting we define tools as different Wikipedia pages.\r\n\r\n```\r\n\r\n\r\nfrom llama_index.core import SimpleDirectoryReader\r\n\r\n\r\n```\r\n\r\n\r\n```\r\n\r\n\r\nwiki_titles = [\"Toronto\", \"Seattle\", \"Chicago\", \"Boston\", \"Houston\"]\r\n\r\n\r\n```\r\n\r\n\r\n```\r\n\r\n\r\nfrom pathlib import Path\r\n\r\n\r\n\r\n\r\n\r\nimport requests\r\n\r\n\r\n\r\n\r\n\r\nfor title in wiki_titles:\r\n\r\n\r\n\r\n\r\nresponse = requests.get(\r\n\r\n\r\n\r\n\r\n\"https://en.wikipedia.org/w/api.php\",\r\n\r\n\r\n\r\n\r\nparams={\r\n\r\n\r\n\r\n\r\n\"action\": \"query\",\r\n\r\n\r\n\r\n\r\n\"format\": \"json\",\r\n\r\n\r\n\r\n\r\n\"titles\": title,\r\n\r\n\r\n\r\n\r\n\"prop\": \"extracts\",\r\n\r\n\r\n\r\n\r\n# 'exintro': True,\r\n\r\n\r\n\r\n\r\n\"explaintext\": True,\r\n\r\n\r\n\r\n\r\n\r\n).json()\r\n\r\n\r\n\r\n\r\npage =next(iter(response[\"query\"][\"pages\"].values()))\r\n\r\n\r\n\r\n\r\nwiki_text = page[\"extract\"]\r\n\r\n\r\n\r\n\r\n\r\ndata_path = Path(\"data\")\r\n\r\n\r\n\r\n\r\nifnot data_path.exists():\r\n\r\n\r\n\r\n\r\nPath.mkdir(data_path)\r\n\r\n\r\n\r\n\r\n\r\nwithopen(data_path /f\"{title}.txt\", \"w\") as fp:\r\n\r\n\r\n\r\n\r\nfp.", "mimetype": "text/plain", "start_char_idx": 0, "end_char_idx": 1961, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, {"__data__": {"id_": "75197641-cc29-4f2e-be3b-e646b981ae29", "embedding": [-0.0671694204211235, -0.025520438328385353, 0.023723391816020012, 0.00698046712204814, 0.017838498577475548, -0.052485391497612, -0.03705519810318947, 0.02372273989021778, -0.029693568125367165, -0.017505677416920662, 0.036753106862306595, -0.04028687626123428, 0.03809002786874771, -0.013523866422474384, 0.010429363697767258, -0.02321312390267849, -0.013016661629080772, -0.014546159654855728, -0.009860556572675705, -0.012770057655870914, 0.032462798058986664, 0.001406748197041452, 0.03553088381886482, -0.03931873291730881, 0.004526408854871988, 0.07548463344573975, -0.002301314612850