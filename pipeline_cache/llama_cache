2116905990988016, 0.029680676758289337, 0.0039652325212955475, 0.003939521498978138, -0.00644746283069253, -0.04058447852730751, -0.0058165076188743114, 0.13746218383312225, -0.04522888734936714, -0.020447328686714172], "metadata": {"file_path": "C:\\Users\\Daniel\\Documents\\llamaindex-course\\llamaindex-docs\\python_examples_agent_agent_workflow_basic.md", "file_name": "python_examples_agent_agent_workflow_basic.md", "file_type": "text/markdown", "file_size": 12702, "creation_date": "2026-04-23", "last_modified_date": "2026-04-23"}, "excluded_embed_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "excluded_llm_metadata_keys": ["file_name", "file_type", "file_size", "creation_date", "last_modified_date", "last_accessed_date"], "relationships": {"1": {"node_id": "0a43c562-3b37-4078-a305-cea88203aab2", "node_type": "4", "metadata": {"file_path": "C:\\Users\\Daniel\\Documents\\llamaindex-course\\llamaindex-docs\\python_examples_agent_agent_workflow_basic.md", "file_name": "python_examples_agent_agent_workflow_basic.md", "file_type": "text/markdown", "file_size": 12702, "creation_date": "2026-04-23", "last_modified_date": "2026-04-23"}, "hash": "20142dc5dd1b4db8f68af62c03262457fda791f43d43464a9cdcddde5b35ab32", "class_name": "RelatedNodeInfo"}, "2": {"node_id": "f1a7b27a-ef84-48a9-b63b-972eecf4bfe6", "node_type": "1", "metadata": {"file_path": "C:\\Users\\Daniel\\Documents\\llamaindex-course\\llamaindex-docs\\python_examples_agent_agent_workflow_basic.md", "file_name": "python_examples_agent_agent_workflow_basic.md", "file_type": "text/markdown", "file_size": 12702, "creation_date": "2026-04-23", "last_modified_date": "2026-04-23"}, "hash": "744acde00628cbfe11e0e8a7cdc5e31542fe285bd581b8bc3128c2e072b2a136", "class_name": "RelatedNodeInfo"}, "3": {"node_id": "f4397b87-12a0-4f70-b819-bc231af6db22", "node_type": "1", "metadata": {}, "hash": "098bb3fa99b445443a93a474b377881c01763b6d0b909e5442d0a04b3d317d10", "class_name": "RelatedNodeInfo"}}, "metadata_template": "{key}: {value}", "metadata_separator": "\n", "text": "This means that the agent will not have any memory of previous runs.\r\nTo maintain state, we need to keep track of the previous state. Since the `FunctionAgent` is running in a `Workflow`, the state is stored in the `Context`. This can be passed between runs to maintain state and history.\r\n\r\n```\r\n\r\n\r\nfrom llama_index.core.workflow import Context\r\n\r\n\r\n\r\n\r\n\r\nctx = Context(agent)\r\n\r\n\r\n```\r\n\r\n\r\n```\r\n\r\n\r\nresponse =await agent.run(\r\n\r\n\r\n\r\n\r\nuser_msg=\"My name is Logan, nice to meet you!\", ctx=ctx\r\n\r\n\r\n\r\n\r\n\r\nprint(str(response))\r\n\r\n\r\n```\r\n\r\n\r\n```\r\n\r\nNice to meet you, Logan! How can I assist you today?\r\n\r\n```\r\n\r\n\r\n```\r\n\r\n\r\nresponse =await agent.run(user_msg=\"What is my name?\", ctx=ctx)\r\n\r\n\r\n\r\n\r\nprint(str(response))\r\n\r\n\r\n```\r\n\r\n\r\n```\r\n\r\nYour name is Logan.\r\n\r\n```\r\n\r\nThe context is serializable, so it can be saved to a database, file, etc. and loaded back in later.\r\nThe `JsonSerializer` is a simple serializer that uses `json.dumps` and `json.loads` to serialize and deserialize the context.\r\nThe `JsonPickleSerializer` is a serializer that uses `pickle` to serialize and deserialize the context. If you have objects in your context that are not serializable, you can use this serializer.\r\n\r\n```\r\n\r\n\r\nfrom llama_index.core.workflow import JsonPickleSerializer, JsonSerializer\r\n\r\n\r\n\r\n\r\n\r\nctx_dict = ctx.to_dict(serializer=JsonSerializer())\r\n\r\n\r\n\r\n\r\n\r\nrestored_ctx = Context.from_dict(agent, ctx_dict, serializer=JsonSerializer())\r\n\r\n\r\n```\r\n\r\n\r\n```\r\n\r\n\r\nresponse =await agent.run(\r\n\r\n\r\n\r\n\r\nuser_msg=\"Do you still remember my name?\", ctx=restored_ctx\r\n\r\n\r\n\r\n\r\n\r\nprint(str(response))\r\n\r\n\r\n```\r\n\r\n\r\n```\r\n\r\nYes, I remember your name is Logan.\r\n\r\n```\r\n\r\n## Streaming\r\n[Section titled \u201cStreaming\u201d](https://developers.llamaindex.ai/python/examples/agent/agent_workflow_basic/#streaming)\r\nThe `AgentWorkflow`/`FunctionAgent` also supports streaming. Since the `AgentWorkflow` is a `Workflow`, it can be streamed like any other `Workflow`. This works by using the handler that is returned from the workflow. There are a few key events that are streamed, feel free to explore below.", "mimetype": "text/plain", "start_char_idx": 3686, "end_char_idx": 5757, "text_template": "{metadata_str}\n\n{content}", "class_name": "TextNode"}, "__type__": "1"}, {"__data__": {"id_": "f4397b87-12a0-4f70-b819-bc231af6db22", "embedding": [-0.021707801148295403, 0.00263951881788671, 0.017022820189595222, -0.009731532074511051, 0.1079484075307846, -0.0641295537352562, 0.004654877819120884, 0.0020203283056616783, -0.020818360149860382, -0.007265089079737663, 0.042864713817834854, 0.00766815384849906, 0.048274680972099304, -0.0027709566056728363, -0.03563707694411278, -0.011351943016052246, -0.0037034929264336824, -0.005264553707093, 0.0019120217766612768, -0.00921874213963747, 0.022528046742081642, 0.0076338560320436954, 0.031179368495941162, -0.017597241327166557, 0.04804510250687599, 0.04642489179968834, -0.016229331493377686, 0.00964272115379572, -0.011127802543342113, -0.16463693976402283, -0.007631008047610521, -0.03896798938512802, -0.02564566396176815, 0.0036832320038229227, -0.0031722616404294968, -0.03969649598002434, -0.00650908425450325, -0.039573442190885544, -0.059954915195703506, 0.01478646881878376, 0.037993039935827255, -0.0007469688425771892, -0.039297230541706085, -0.0004959232755936682, -0.043660786002874374, -0.061993684619665146, 0.0233144573867321, 0.055440694093704224, -0.03000539168715477, 0.015830259770154953, -0.02075141854584217, -0.04746360331773758, -0.006215915083885193, -0.015193324536085129, 0.011466112919151783, -0.023023046553134918, 0.03565594553947449, 0.05372431129217148, 0.044318269938230515, -0.03